GEMINI_API_KEY=
ELEVENLABS_API_KEY=
MEMORY_ENABLED=false
MONGODB_ATLAS_URI=
MONGODB_DB=jarvis_dev
ENCRYPTION_KEY=
LOCAL_FALLBACK_PATH=./data/fallback.sqlite3
RETENTION_DAYS=90
PROFILE_RETENTION_DAYS=180
# Set a model returned by: python scripts/check_embeddings.py
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
FACE_DETECTION_MODEL=models/face_detection_yunet_2023mar.onnx
FACE_RECOGNITION_MODEL=models/face_recognition_sface_2021dec.onnx
FACE_MATCH_THRESHOLD=0.363
FACE_GREET_THRESHOLD=0.5

# Positivity is an unverified, opt-in hardware MVP. No new API keys.
POSITIVITY_ENABLED=false
POSITIVITY_PRIVACY_MODE=crop
POSITIVITY_DWELL_S=1.0
POSITIVITY_COOLDOWN_MIN=10
POSITIVITY_MAX_FACES=3
POSITIVITY_MIN_REFERENCED=2
# Set explicitly to the agent voice; the adapter does not query the dashboard.
POSITIVITY_VOICE_ID=
# eleven_flash_v2_5 is ElevenLabs' lowest-cost/lowest-latency tier (roughly
# half the per-character price of Turbo v2.5, a fraction of Multilingual v2).
# The notice is always synthesized with this model regardless of this
# setting; raise this one for the remark only once cost is not a concern.
POSITIVITY_TTS_MODEL=eleven_flash_v2_5
POSITIVITY_OPT_OUT_WORDS=
POSITIVITY_NOTICE=full
